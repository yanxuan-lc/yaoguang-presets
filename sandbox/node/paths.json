          "id": "volta",
          "path": "~/.volta",
          "targetType": "directory",
          "description": "Node.js 与版本管理器：工具、配置及附属数据的递归读取；核对整个目录范围。",
          "containsCredentials": true,
          "sources": [
            "https://docs.volta.sh/advanced/installers"
          ]
        },
