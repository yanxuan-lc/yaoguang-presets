          ]
        },
        {
          "id": "config",
          "path": "~/.nuget/NuGet/NuGet.Config",
          "targetType": "file",
          "description": ".NET / NuGet：用户配置读取，可能包含认证参数或外部文件引用。",
          "containsCredentials": true,
          "sources": [
            "https://learn.microsoft.com/en-us/nuget/reference/nuget-config-file"
          ]
        },
        {
          "id": "mono-config",
