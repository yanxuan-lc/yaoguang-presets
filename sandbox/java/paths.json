{
  "id": "java",
  "name": "Java / Maven / Gradle / SDKMAN",
  "description": "Java / Maven / Gradle / SDKMAN 的研发配置、工具与依赖读取候选。",
  "verification": {
    "level": "documentation",
    "toolVersions": [
      "Maven 3.9",
      "Gradle current",
      "SDKMAN current"
