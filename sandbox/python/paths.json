          "id": "custom-config",
          "path": "${PIP_CONFIG_FILE}",
          "targetType": "file",
          "description": "Python / pip / pyenv：用户配置读取，可能包含认证参数或外部文件引用。",
          "containsCredentials": true,
          "sources": [
            "https://pip.pypa.io/en/stable/topics/configuration/"
          ]
